---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";

// Ini akan menangkap data dari bagian atas file Markdown Anda
const { frontmatter } = Astro.props;
---

<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{frontmatter.title} | Bagus Wicaksono</title>
    <ClientRouter />

    <style is:global>
      @keyframes blob {
        0% {
          transform: translate(0px, 0px) scale(1);
        }
        33% {
          transform: translate(30px, -50px) scale(1.1);
        }
        66% {
          transform: translate(-20px, 20px) scale(0.9);
        }
        100% {
          transform: translate(0px, 0px) scale(1);
        }
      }
      .animate-blob {
        animation: blob 7s infinite;
      }
      .animation-delay-2000 {
        animation-delay: 2s;
      }
      .animation-delay-4000 {
        animation-delay: 4s;
      }

      /* --- STYLING MODERN UNTUK MARKDOWN --- */

      /* Teks paragraf biasa */
      .markdown-content p {
        color: #d1d5db; /* gray-300 */
        font-size: 1.125rem; /* Teks sedikit lebih besar agar nyaman dibaca */
        line-height: 1.8;
        margin-bottom: 1.5rem;
      }

      /* Heading 2 (H2) - Judul Bagian */
      .markdown-content h2 {
        font-size: 1.875rem;
        font-weight: 800;
        color: #fff;
        margin-top: 3.5rem;
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
      }
      /* Hiasan garis hijau di samping H2 */
      .markdown-content h2::before {
        content: "";
        display: block;
        width: 1.5rem;
        height: 0.25rem;
        background-color: #10b981; /* emerald-500 */
        border-radius: 9999px;
      }

      /* Daftar berpoin (Bullet Lists) */
      .markdown-content ul {
        margin-bottom: 2rem;
        padding-left: 0;
      }
      .markdown-content li {
        color: #9ca3af; /* gray-400 */
        font-size: 1.1rem;
        line-height: 1.7;
        margin-bottom: 1rem;
        padding-left: 2rem;
        position: relative;
      }
      /* Mengubah titik bulat biasa menjadi panah hijau custom */
      .markdown-content li::before {
        content: "▹";
        position: absolute;
        left: 0;
        top: -0.1rem;
        color: #10b981; /* emerald-500 */
        font-size: 1.25rem;
        font-weight: bold;
      }

      /* Teks Cetak Tebal (Bold) */
      .markdown-content strong {
        color: #f3f4f6; /* gray-100 */
        font-weight: 700;
        background: rgba(
          255,
          255,
          255,
          0.05
        ); /* Sedikit highlight background */
        padding: 0 0.25rem;
        border-radius: 0.25rem;
      }

      /* Teks Miring / Emphasis (Italic) */
      .markdown-content em {
        color: #34d399; /* emerald-400 */
        font-style: italic;
      }

      /* Kutipan (Blockquote) */
      .markdown-content blockquote {
        margin-top: 3rem;
        margin-bottom: 3rem;
        padding: 1.5rem 2rem;
        background: linear-gradient(
          to right,
          rgba(16, 185, 129, 0.1),
          transparent
        );
        border-left: 4px solid #10b981;
        border-radius: 0 0.5rem 0.5rem 0;
        font-size: 1.25rem;
        font-style: italic;
        color: #e5e7eb;
      }

      /* Mereset gaya italic bawaan p di dalam blockquote agar tidak dobel */
      .markdown-content blockquote p {
        margin-bottom: 0;
        color: inherit;
      }
    </style>
  </head>

  <body
    class="bg-gray-900 text-gray-100 font-sans antialiased selection:bg-emerald-500 selection:text-white relative min-h-screen flex flex-col"
  >
    <!-- Background Cahaya -->
    <div
      transition:persist="background"
      class="fixed inset-0 z-0 overflow-hidden pointer-events-none"
    >
      <div
        class="absolute top-[-10%] left-[-10%] w-96 h-96 bg-emerald-600 rounded-full mix-blend-screen filter blur-[128px] opacity-30 animate-blob"
      >
      </div>
      <div
        class="absolute top-[20%] right-[-10%] w-96 h-96 bg-blue-600 rounded-full mix-blend-screen filter blur-[128px] opacity-30 animate-blob animation-delay-2000"
      >
      </div>
    </div>

    <!-- Sticky Navigasi (DISESUAIKAN MENJADI max-w-6xl) -->
    <header
      class="sticky top-0 z-50 w-full bg-gray-900/60 backdrop-blur-md transition-all"
    >
      <div
        class="max-w-6xl mx-auto px-6 py-4 flex justify-between items-center"
      >
        <!-- Tombol Back ke Home -->
        <a
          href="/"
          class="text-gray-400 hover:text-emerald-400 transition flex items-center gap-2 text-sm font-medium"
        >
          &larr; Kembali
        </a>
        <nav class="flex space-x-6 text-sm font-medium">
          <a href="/" class="text-gray-400 hover:text-white transition">Home</a>
          <a href="/about" class="text-gray-400 hover:text-white transition"
            >About</a
          >
        </nav>
      </div>
    </header>

    <!-- Kontainer Konten Markdown (DISESUAIKAN MENJADI max-w-6xl) -->
    <div class="max-w-6xl mx-auto w-full relative z-10 flex flex-col grow mt-8">
      <main class="grow px-6 pb-20">
        <!-- Header Proyek -->
        <div class="mb-10">
          <span
            class="bg-emerald-900/50 text-emerald-400 px-3 py-1 rounded-full text-xs font-semibold tracking-wider uppercase"
            >{frontmatter.category}</span
          >
          <h1 class="text-4xl md:text-5xl font-extrabold mt-4 mb-4">
            {frontmatter.title}
          </h1>

          <div class="flex items-center gap-4">
            <p class="text-gray-400">{frontmatter.date}</p>

            <!-- Logika Pintar: Tombol GitHub hanya muncul jika ada data "github" di markdown -->
            {
              frontmatter.github && (
                <>
                  <span class="text-gray-600">•</span>
                  <a
                    href={frontmatter.github}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex items-center gap-2 text-gray-300 hover:text-white bg-gray-800 hover:bg-gray-700 px-3 py-1.5 rounded-lg border border-gray-700 transition"
                  >
                    <svg
                      class="w-5 h-5"
                      fill="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        fill-rule="evenodd"
                        d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
                        clip-rule="evenodd"
                      />
                    </svg>
                    <span class="text-sm font-medium">Lihat Repositori</span>
                  </a>
                </>
              )
            }
          </div>
        </div>

        <!-- Teks Markdown akan dirender di dalam slot ini -->
        <article class="markdown-content">
          <slot />
        </article>
      </main>
    </div>
  </body>
</html>
