---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
---

<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Portofolio | Junior Software Developer</title>

    <ClientRouter />

    <style is:global>
      @keyframes blob {
        0% {
          transform: translate(0px, 0px) scale(1);
        }
        33% {
          transform: translate(30px, -50px) scale(1.1);
        }
        66% {
          transform: translate(-20px, 20px) scale(0.9);
        }
        100% {
          transform: translate(0px, 0px) scale(1);
        }
      }
      .animate-blob {
        animation: blob 7s infinite;
      }
      .animation-delay-2000 {
        animation-delay: 2s;
      }
      .animation-delay-4000 {
        animation-delay: 4s;
      }

      .no-scrollbar {
        -ms-overflow-style: none; /* IE and Edge */
        scrollbar-width: none; /* Firefox */
      }
      .no-scrollbar::-webkit-scrollbar {
        display: none; /* Chrome, Safari and Opera */
        width: 0;
        height: 0;
      }
    </style>
  </head>

  <body
    class="bg-gray-900 text-gray-100 font-sans antialiased selection:bg-emerald-500 selection:text-white relative min-h-screen flex flex-col"
  >
    <div
      transition:persist="background"
      class="fixed inset-0 z-0 overflow-hidden pointer-events-none"
    >
      <div
        class="absolute top-[-10%] left-[-10%] w-96 h-96 bg-emerald-600 rounded-full mix-blend-screen filter blur-[128px] opacity-30 animate-blob"
      >
      </div>
      <div
        class="absolute top-[20%] right-[-10%] w-96 h-96 bg-blue-600 rounded-full mix-blend-screen filter blur-[128px] opacity-30 animate-blob animation-delay-2000"
      >
      </div>
      <div
        class="absolute bottom-[-20%] left-[20%] w-96 h-96 bg-teal-600 rounded-full mix-blend-screen filter blur-[128px] opacity-30 animate-blob animation-delay-4000"
      >
      </div>
    </div>

    <div class="max-w-6xl mx-auto w-full relative z-10 flex flex-col grow">
      <header
        class="sticky top-0 z-50 px-6 py-4 mb-8 bg-gray-900/60 backdrop-blur-md border-b border-transparent transition-all"
      >
        <nav class="flex justify-end space-x-6 text-sm font-medium">
          <a href="/" class="text-emerald-400 hover:text-emerald-300 transition"
            >Home</a
          >
          <a href="/about" class="text-gray-400 hover:text-white transition"
            >About</a
          >
        </nav>
      </header>

      <main class="grow px-6">
        <section class="mb-20">
          <h1 class="text-4xl md:text-6xl font-extrabold leading-tight mb-4">
            Membangun aplikasi dengan <br />
            <span
              class="text-transparent bg-clip-text bg-linear-to-r from-emerald-400 to-blue-500"
            >
              performa tinggi & arsitektur rapi.
            </span>
          </h1>
          <p class="text-gray-400 text-lg max-w-2xl leading-relaxed">
            Selamat datang di halaman portofolio saya. Perancangan dan
            pengembangan aplikasi menggunakan AI sebagai asisten untuk
            mempercepat perancangan aplikasi. Tentu dibutuhkan pengetahuan dasar
            untuk memahami kebutuhan dan arsitektur aplikasi yang baik.
          </p>
        </section>

        <section class="mb-20">
          <div class="flex items-center justify-between mb-8">
            <h2 class="text-2xl font-bold flex items-center gap-2">
              <span class="w-8 h-1 bg-emerald-500 rounded-full"></span> Proyek Pilihan
            </h2>

            <!-- TOMBOL PANAH DIPERBARUI: Minimalis tanpa bulatan background -->
            <div class="flex gap-4">
              <button
                id="btn-prev"
                aria-label="Geser Kiri"
                class="p-1 text-gray-500 hover:text-emerald-400 transition transform hover:-translate-x-1 focus:outline-none"
              >
                <svg
                  class="w-7 h-7"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M15 19l-7-7 7-7"></path></svg
                >
              </button>
              <button
                id="btn-next"
                aria-label="Geser Kanan"
                class="p-1 text-gray-500 hover:text-emerald-400 transition transform hover:translate-x-1 focus:outline-none"
              >
                <svg
                  class="w-7 h-7"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M9 5l7 7-7 7"></path></svg
                >
              </button>
            </div>
          </div>
          <!-- proyek slider -->
          <div
            id="projects-slider"
            class="flex gap-6 overflow-x-auto snap-x snap-mandatory no-scrollbar scroll-smooth pt-4 pb-8 items-stretch -mt-4"
          >
            <!-- Card 1 -->
            <div
              class="shrink-0 snap-start w-[85%] sm:w-[calc(50%-12px)] lg:w-[calc(33.333%-16px)] bg-gray-800 border border-gray-700 p-6 rounded-2xl hover:-translate-y-2 hover:shadow-xl hover:shadow-emerald-900/20 transition duration-300 group flex flex-col"
            >
              <h3
                class="text-xl font-bold text-white mb-3 group-hover:text-emerald-400 transition"
              >
                Sistem Pengingat Imunisasi Klinik
              </h3>
              <p class="text-gray-400 text-sm mb-6 grow line-clamp-3">
                Aplikasi mobile terintegrasi untuk membantu klinik dan pasien
                melacak jadwal imunisasi. Dirancang dengan perancangan sequence
                diagram yang matang dan pengujian UAT.
              </p>
              <div
                class="mt-auto flex items-center justify-between border-t border-gray-700/50 pt-4"
              >
                <a
                  href="/projects/imunisasi"
                  class="text-emerald-400 text-sm font-semibold hover:underline"
                  >Lihat Studi Kasus &rarr;</a
                >
                <a
                  href="https://github.com/Nakula4/aplikasi-imunisasi"
                  target="_blank"
                  title="Lihat Kode di GitHub"
                  class="text-gray-400 hover:text-white transition"
                >
                  <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"
                    ><path
                      fill-rule="evenodd"
                      d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
                      clip-rule="evenodd"></path></svg
                  >
                </a>
              </div>
            </div>

            <!-- Card 2 -->
            <div
              class="shrink-0 snap-start w-[85%] sm:w-[calc(50%-12px)] lg:w-[calc(33.333%-16px)] bg-gray-800 border border-gray-700 p-6 rounded-2xl hover:-translate-y-2 hover:shadow-xl hover:shadow-blue-900/20 transition duration-300 group flex flex-col"
            >
              <h3
                class="text-xl font-bold text-white mb-3 group-hover:text-blue-400 transition"
              >
                Telegram Bot Storage
              </h3>
              <p class="text-gray-400 text-sm mb-6 grow line-clamp-3">
                Bot Telegram untuk menyimpan dan menyortir file sesuai dengan
                format. Solusi cloud storage gratis yang memanfaatkan Telegram
                sebagai platform penyimpanan file.
              </p>
              <div
                class="mt-auto flex items-center justify-between border-t border-gray-700/50 pt-4"
              >
                <a
                  href="/projects/telegram-storage"
                  class="text-blue-400 text-sm font-semibold hover:underline"
                  >Lihat Studi Kasus &rarr;</a
                >
                <a
                  href="https://github.com/Nakula4/telegram-storage"
                  target="_blank"
                  title="Lihat Kode di GitHub"
                  class="text-gray-400 hover:text-white transition"
                >
                  <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"
                    ><path
                      fill-rule="evenodd"
                      d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
                      clip-rule="evenodd"></path></svg
                  >
                </a>
              </div>
            </div>

            <!-- Card 3 -->
            <div
              class="shrink-0 snap-start w-[85%] sm:w-[calc(50%-12px)] lg:w-[calc(33.333%-16px)] bg-gray-800 border border-gray-700 p-6 rounded-2xl hover:-translate-y-2 hover:shadow-xl hover:shadow-emerald-900/20 transition duration-300 group flex flex-col"
            >
              <h3
                class="text-xl font-bold text-white mb-3 group-hover:text-emerald-400 transition"
              >
                LevelUp: Workout Discipline
              </h3>
              <p class="text-gray-400 text-sm mb-6 grow line-clamp-3">
                Aplikasi mobile pelacak rutinitas olahraga. Dirancang dengan
                fokus pada retensi pengguna dan visualisasi data performa secara
                offline.
              </p>
              <div
                class="mt-auto flex items-center justify-between border-t border-gray-700/50 pt-4"
              >
                <a
                  href="/projects/levelup"
                  class="text-emerald-400 text-sm font-semibold hover:underline"
                  >Lihat Studi Kasus &rarr;</a
                >
                <a
                  href="https://github.com/Nakula4/projectLevelup"
                  target="_blank"
                  title="Lihat Kode di GitHub"
                  class="text-gray-400 hover:text-white transition"
                >
                  <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"
                    ><path
                      fill-rule="evenodd"
                      d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
                      clip-rule="evenodd"></path></svg
                  >
                </a>
              </div>
            </div>
          </div>
          <!-- ... (Kode section slider proyek di atasnya) ... -->
        </section>
        <section class="mt-32 mb-20 text-center">
          <h2 class="text-3xl md:text-4xl font-bold mb-6">
            Punya masalah yang perlu dipecahkan?
          </h2>
          <p
            class="text-gray-400 text-lg mb-8 max-w-2xl mx-auto leading-relaxed"
          >
            Saya selalu terbuka untuk mendiskusikan peluang kolaborasi, proyek
            pengembangan perangkat lunak, atau sekadar bertukar pikiran tentang
            teknologi.
          </p>
          <a
            href="mailto:baguswicaksono880@gmail.com"
            class="inline-flex items-center gap-2 bg-emerald-500 hover:bg-emerald-400 text-gray-900 font-bold px-8 py-3.5 rounded-full transition-all duration-300 transform hover:-translate-y-1 hover:shadow-lg hover:shadow-emerald-500/25"
          >
            <svg
              class="w-5 h-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
              ></path></svg
            >
            Mari Berdiskusi
          </a>
        </section>
      </main>

      <!-- BAGIAN BARU: Footer -->
      <footer
        class="border-t border-gray-800/60 py-8 mt-auto flex flex-col md:flex-row items-center justify-between text-sm text-gray-500 px-6"
      >
        <p>&copy; 2026 Bagus Wicaksono. All rights reserved.</p>

        <div class="flex space-x-4 mt-4 md:mt-0">
          <a
            href="https://github.com/Nakula4"
            target="_blank"
            class="hover:text-emerald-400 transition"
            aria-label="GitHub"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"
              ><path
                fill-rule="evenodd"
                d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
                clip-rule="evenodd"></path></svg
            >
          </a>
          <!-- Jika Anda punya LinkedIn, ganti tanda # dengan link Anda -->
          <a
            href="#"
            target="_blank"
            class="hover:text-emerald-400 transition"
            aria-label="LinkedIn"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"
              ><path
                d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"
              ></path></svg
            >
          </a>
        </div>
      </footer>
    </div>
    <!-- ... (Tag Script Anda yang ada di bagian paling bawah) ... -->

    <script>
      document.addEventListener("astro:page-load", () => {
        const slider = document.getElementById("projects-slider");
        const btnPrev = document.getElementById("btn-prev");
        const btnNext = document.getElementById("btn-next");

        if (slider && btnPrev && btnNext) {
          const getScrollAmount = () => {
            // Perbaikan: Tambahkan tanda tanya (?) dan fallback (|| 0)
            const cardWidth = slider.firstElementChild?.clientWidth || 0;
            return cardWidth + 24; // 24 adalah gap-6
          };

          btnNext.addEventListener("click", () => {
            slider.scrollBy({ left: getScrollAmount(), behavior: "smooth" });
          });

          btnPrev.addEventListener("click", () => {
            slider.scrollBy({ left: -getScrollAmount(), behavior: "smooth" });
          });
        }
      });
    </script>
  </body>
</html>
